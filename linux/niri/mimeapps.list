[Default Applications]
text/html=zen.desktop
x-scheme-handler/http=zen.desktop
x-scheme-handler/https=zen.desktop
x-scheme-handler/about=zen.desktop
x-scheme-handler/unknown=zen.desktop
text/x-shellscript=code.desktop;
text/plain=org.gnome.TextEditor.desktop
application/pdf=zen.desktop
application/x-pdf=zen.desktop

[Added Associations]
# JavaScript / TypeScript
text/javascript=code.desktop
application/javascript=code.desktop
application/x-javascript=code.desktop
text/jscript=code.desktop
text/ecmascript=code.desktop
application/ecmascript=code.desktop
text/typescript=code.desktop
application/typescript=code.desktop

# JSON, YAML, TOML, etc.
application/json=code.desktop
application/x-yaml=code.desktop
text/yaml=code.desktop
text/x-yaml=code.desktop
application/toml=code.desktop
text/x-toml=code.desktop

# Python, etc.
text/x-python=code.desktop
text/x-python3=code.desktop
application/x-python=code.desktop

# Markdown y otros
text/markdown=code.desktop
text/x-markdown=code.desktop
