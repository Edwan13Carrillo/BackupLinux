{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "color": {
            "1": "0"
        }
    },
    "display": {
        "separator": "\u001b[38;5;242m󰇙\u001b[0m",
        "color": {
            "keys": "38;5;147"
        },
        "key": {
            "width": 20
        }
    },
    "modules": [
        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;141m╭───────────────────────────────────────────────────────────────╮\u001b[0m"
        },
        "break",

        {
            "type": "custom",
            "format": " \u001b[38;5;141m\u001b[48;5;141m\u001b[38;5;232m  SYSTEM INFORMATION  \u001b[0m\u001b[38;5;141m\u001b[0m"
        },

        {
            "type": "os",
            "key": " 󰣇  OS          󱞩",
            "keyColor": "35"
        },
        {
            "type": "kernel",
            "key": "   KERNEL      󱞩",
            "keyColor": "35"
        },
        {
            "type": "uptime",
            "key": " 󰔠  UPTIME      󱞩",
            "keyColor": "35",
            "format": "{1}h {2}m"
        },
        {
            "type": "packages",
            "key": " 󰏓  PACKAGES    󱞩",
            "keyColor": "35"
        },

        "break",

        {
            "type": "custom",
            "format": " \u001b[38;5;220m\u001b[48;5;220m\u001b[38;5;232m  DESKTOP ENVIRONMENT  \u001b[0m\u001b[38;5;220m\u001b[0m"
        },
        {
            "type": "command",
            "key": " 󰧨  DESKTOP     󱞩",
            "keyColor": "33",
            "text": "noctalia --version"
        },
        {
            "type": "wm",
            "key": " 󱂬  COMPOSITOR  󱞩",
            "keyColor": "33"
        },
        {
            "type": "terminal",
            "key": "   TERMINAL    󱞩",
            "keyColor": "33"
        },
        {
            "type": "shell",
            "key": " 󰞷  SHELL       󱞩",
            "keyColor": "33"
        },

        "break",

        {
            "type": "custom",
            "format": " \u001b[38;5;147m\u001b[48;5;147m\u001b[38;5;232m  HARDWARE INFORMATION  \u001b[0m\u001b[38;5;147m\u001b[0m"
        },
        {
            "type": "cpu",
            "key": " 󰻠  PROCESSOR   󱞩",
            "keyColor": "35",
            "format": "{1} ({3})"
        },
        {
            "type": "gpu",
            "key": " 󰢮  GRAPHICS    󱞩",
            "keyColor": "35"
        },
        {
            "type": "memory",
            "key": " 󰍛  MEMORY      󱞩",
            "keyColor": "35"
        },
        {
            "type": "disk",
            "key": " 󰋊  STORAGE     󱞩",
            "keyColor": "35",
            "folders": "/"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;141m╰───────────────────────────────────────────────────────────────╯\u001b[0m"
        },

        "break"
    ]
}
